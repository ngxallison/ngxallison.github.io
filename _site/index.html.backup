    </div>

    <div class="skills-group">
      <div class="skills-group__title">Languages Spoken</div>
      <div class="skill-item">
        <span class="skill-item__name">English</span>
        <div class="skill-item__bar"><div class="skill-item__fill" style="animation-delay:0.1s"></div></div>
      </div>
      <div class="skill-item">
        <span class="skill-item__name">Cantonese</span>
